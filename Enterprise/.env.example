# Docker Compose deployment (Enterprise/docker-compose.yml).
# Copy to Enterprise/.env. Never commit the filled file.
# Fill ALL empty secrets with unique, cryptographically random values
# (example generator: openssl rand -hex 32).
# Do not rotate MYSQL_PASSWORD on an existing MySQL volume without updating
# the database user's password in MySQL first.
MYSQL_DATABASE=it_toolkit
MYSQL_USER=itk_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# All required by server.js or Compose; never reuse the same value.
API_TOKEN=
JWT_SECRET=
BOOTSTRAP_SECRET=
HMAC_SECRET=
COMMAND_SIGNING_KEY=
SETUP_TOKEN=

# Set to the public DNS hostname of your Docker VPS, never localhost/IP.
SERVER_HOST=
# Example for a domain-based TLS deployment: CADDY_HOST=toolkit.example.com
CADDY_HOST=
ENVIRONMENT=prod

# Designate the actual persisted platform SUPER_ADMIN after first setup.
# Empty values deliberately deny changing server-global settings in production.
PLATFORM_ADMIN_USER_ID=
PLATFORM_OWNER_TENANT_ID=


# Optional: after independent Windows Authenticode/publisher verification,
# set to the exact release MSI SHA-256 from CI SHA256SUMS.txt.
# Blank means production MSI downloads are BLOCKED (fail closed).
APPROVED_MSI_SHA256=
