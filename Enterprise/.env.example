# Docker Compose deployment (Enterprise/docker-compose.yml).
# Copy to Enterprise/.env. Never commit the filled file.
# Fill ALL empty secrets with unique, cryptographically random values
# (example generator: openssl rand -hex 32).
# Do not rotate MYSQL_PASSWORD on an existing MySQL volume without updating
# the database user's password in MySQL first.
MYSQL_DATABASE=it_toolkit
MYSQL_USER=itk_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# All required by server.js or Compose; never reuse the same value.
API_TOKEN=
JWT_SECRET=
BOOTSTRAP_SECRET=
HMAC_SECRET=
COMMAND_SIGNING_KEY=
SETUP_TOKEN=

# Set to the public DNS hostname of your Docker VPS, never localhost/IP.
SERVER_HOST=
# Example for a domain-based TLS deployment: CADDY_HOST=toolkit.example.com
CADDY_HOST=
ENVIRONMENT=prod

# Designate the actual persisted platform SUPER_ADMIN after first setup.
# Empty values deliberately deny changing server-global settings in production.
PLATFORM_ADMIN_USER_ID=
PLATFORM_OWNER_TENANT_ID=


# Optional: after independent Windows Authenticode/publisher verification,
# set to the exact release MSI SHA-256 from CI SHA256SUMS.txt.
# Blank means production MSI downloads are BLOCKED (fail closed).
APPROVED_MSI_SHA256=

# Stage N15: exact, comma-separated HTTPS destination hostnames, no wildcards.
# Empty deliberately blocks all outbound tenant alert webhooks.
# Example: WEBHOOK_ALLOWED_HOSTS=hooks.slack.com,example.webhook.office.com
WEBHOOK_ALLOWED_HOSTS=

# Stage N16: private server-owned SMTP; no plaintext AUTH or disabled TLS.
# Requires valid TLS (port 465) or mandatory STARTTLS (usually port 587).
# Missing any required setting disables email delivery for all workspaces.
# Exact comma-separated recipient domains, no wildcards, must be approved.
# Do not put SMTP passwords in a browser, logs or git.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALLOWED_RECIPIENT_DOMAINS=
SMTP_TIMEOUT_MS=12000

# Stage N19: optional private GitHub Actions build dispatch for platform operator.
# Use exact authorized owner/repo and a scoped Actions workflow token.
# NEVER put this token in the setup UI or in a GitHub commit.
# Omit both to disable workflow dispatch by default.
GITHUB_ACTIONS_REPO=
GITHUB_ACTIONS_TOKEN=
