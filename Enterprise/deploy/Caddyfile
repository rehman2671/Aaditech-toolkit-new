# Node/MySQL production reverse proxy (deployed via deploy-mysql.sh).
#
# Only deploy with a real DNS hostname (CADDY_HOST=toolkit.example.com),
# whose A/AAAA record reaches this host and ports 80/443 are publicly open.
# Caddy obtains and renews the server certificate automatically via ACME.
#
# Agent traffic uses HTTPS + per-device bearer credentials at the Node API.
# The former :9443 mTLS listener was not usable: the Node enrollment endpoint
# does not issue a client PFX. Do NOT advertise this stack as mTLS-capable.
# A separate fully implemented client-cert issuance + validation flow will be
# needed before strict mTLS can be enabled again.
{$CADDY_HOST} {
    encode zstd gzip

    # No public application metrics, debug docs, or schema endpoints.
    @private path /metrics /docs /docs/* /redoc /redoc/* /openapi.json /api-docs /api-docs/*
    respond @private 404

    reverse_proxy api:3000
}
