{
  "name": "aaditech-toolkit-enterprise",
  "version": "1.0.0",
  "description": "IT-Toolkit Enterprise Administration, Monitoring & Automation Portal",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "start:cluster": "pm2 start ecosystem.config.cjs --env production",
    "start:pm2-runtime": "pm2-runtime start ecosystem.config.cjs",
    "stop:cluster": "pm2 stop ecosystem.config.cjs",
    "reload:cluster": "pm2 reload ecosystem.config.cjs",
    "build": "echo 'No build required for Node Express static server'",
    "lint": "node -c server.js && node scripts/check-version-consistency.cjs",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "node test-contract-validation.js",
    "test:version": "node scripts/check-version-consistency.cjs",
    "test:all": "node scripts/check-version-consistency.cjs && vitest run --coverage && node test-contract-validation.js && node test-auth-integration.js && node test-migrations-runner.js && node test-msi-packaging-integration.js",
    "audit:refresh": "node audit/scanner.cjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "mysql2": "^3.24.3",
    "pm2": "^7.0.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "supertest": "^7.2.2",
    "vitest": "^5.0.1"
  }
}
